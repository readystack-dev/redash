# =====================================================================
# Redash v26.9.0 (BSD-2-Clause) VENDOR build — Flask+RQ AIO (paperless pattern, Flask flavor):
#  (1) node:24 throwaway stage builds client/dist (pnpm frozen lockfile, as upstream since v26.9);
#  (2) CPython 3.13 builder (ubuntu:24.04, compiled from python.org's source): uv export (MAIN group ONLY —
#      no all_ds ~45 drivers, no dev tooling, no GPL ldap3, no proprietary ODBC blobs) -> pip into
#      /opt/venv + CVE floors;
#  (3) the application tree (the same CPython) + supervisord AIO (gunicorn + rq worker
#      [all 6 queues] + rq scheduler).
# Telemetry off (REDASH_VERSION_CHECK=false). Exports the venv + app tree as tars and the chiselled Ubuntu 24.04 runtime
# (chiselcut) for the hermetic offline reassembly FROM scratch (runtime_base, from v26.9.0-CE-ubuntu24.04-r8).
# =====================================================================
ARG REDASH_VERSION=26.9.0

# alpine/git 2.54.0 by its index digest (Docker Hub's registry, read 2026-11-02): only a git client for the clone below;
# the tag and the commit check below pin the source, the digest pins the client that fetched it.
FROM alpine/git:2.54.0@sha256:ac6c828f15d82775d204d3d75112e1d34af8945da80ccf922713c9891ba68e7a AS src
ARG REDASH_VERSION
RUN git clone --depth 1 --branch v${REDASH_VERSION} https://github.com/getredash/redash /src && \
    test "$(git -C /src rev-parse HEAD)" = 42fdf9d4a0fdb83841130ab78f69899a224f281b && rm -rf /src/.git

# v26.9 moved the frontend from yarn to pnpm (pnpm@10.30.3, Node 24) — mirrors upstream's Dockerfile.
FROM node:24-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4 AS frontend
ENV CYPRESS_INSTALL_BINARY=0 PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1
RUN npm install -g pnpm@10.30.3
WORKDIR /frontend
COPY --from=src /src/package.json /src/pnpm-lock.yaml /src/pnpm-workspace.yaml /src/.npmrc /frontend/
COPY --from=src /src/viz-lib /frontend/viz-lib
COPY --from=src /src/scripts /frontend/scripts
RUN pnpm install --frozen-lockfile
COPY --from=src /src/client /frontend/client
COPY --from=src /src/webpack.config.js /frontend/
RUN pnpm run build

# ---- CPython 3.13.18 compiled from python.org's source against Ubuntu 24.04's own libraries (libssl3t64,
#      libsqlite3-0, libexpat1, zlib1g, ... -- debs the scan sees and apt fixes). This stage only FETCHES the
#      tarball (python.org's sha256, pinned in strategies/redash.json source.python_runtime) and the build
#      toolchain's debs; `cpython` compiles them with gen_dockerfile.cpython_build_cmd, and the offline build runs
#      the same command on the same vendored inputs -- the interpreter that ships is compiled with the network off. ----
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS cpython-src
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /vendored-python && curl -fsSL --retry 3 -o /vendored-python/Python-3.13.18.tar.xz https://www.python.org/ftp/python/3.13.18/Python-3.13.18.tar.xz && \
    echo "abb0102e6d4ae027509bcb82327d9dd85515b44a3ba8ad538cfc5e9847029f68  /vendored-python/Python-3.13.18.tar.xz" | sha256sum -c -
# a FRESH pinned base, nothing installed first: the closure is then complete for the equally fresh offline stage
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS cpython-debs
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get -y --download-only --no-install-recommends install \
      build-essential pkg-config xz-utils libssl-dev zlib1g-dev libbz2-dev libsqlite3-dev libffi-dev liblzma-dev libzstd-dev uuid-dev libexpat1-dev libncurses-dev libreadline-dev && \
    mkdir -p /debs && cp /var/cache/apt/archives/*.deb /debs/ && echo "vendored $(ls -1 /debs/*.deb | wc -l) CPython build debs"
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS cpython
ARG SOURCE_DATE_EPOCH=1794458806
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
COPY --from=cpython-debs /debs /tmp/cpython-debs
COPY --from=cpython-src /vendored-python/Python-3.13.18.tar.xz /tmp/Python-3.13.18.tar.xz
RUN set --; for f in /tmp/cpython-debs/*.deb; do [ -e "$f" ] && set -- "$@" "$f"; done; \
    for pass in 1 2 3 4 5; do [ $# -eq 0 ] || dpkg -i --skip-same-version "$@" >/dev/null 2>&1 && break; done; \
    dpkg --configure -a && bad= && for d in "$@"; do p=$(dpkg-deb -f "$d" Package) v=$(dpkg-deb -f "$d" Version); \
      case "$(dpkg-query -W -f='${Version} ${db:Status-Abbrev}' "$p" 2>/dev/null)" in "$v ii"*) ;; *) bad="$bad $p=$v" ;; esac; done && \
    { [ -z "$bad" ] || { echo "vendored debs not installed at their vendored version:$bad" >&2; false; }; } && \
    : "${SOURCE_DATE_EPOCH:?the CPython build needs SOURCE_DATE_EPOCH}" && \
    echo "abb0102e6d4ae027509bcb82327d9dd85515b44a3ba8ad538cfc5e9847029f68  /tmp/Python-3.13.18.tar.xz" | sha256sum -c - && \
    mkdir -p /usr/src/python && tar -xJf /tmp/Python-3.13.18.tar.xz -C /usr/src/python --strip-components=1 --no-same-owner && \
    rm -rf /tmp/cpython-debs /tmp/Python-3.13.18.tar.xz && cd /usr/src/python && \
    export DEB_BUILD_MAINT_OPTIONS=optimize=-lto && \
    PYCF="$(dpkg-buildflags --get CFLAGS) $(dpkg-buildflags --get CPPFLAGS)" && PYLD="$(dpkg-buildflags --get LDFLAGS)" && \
    ./configure --build=x86_64-linux-gnu --prefix=/usr/local --enable-shared --enable-loadable-sqlite-extensions --enable-option-checking=fatal --disable-test-modules --without-static-libpython --with-ensurepip=install --with-system-expat --without-system-libmpdec --with-dbmliborder= py_cv_module__dbm=n/a py_cv_module__gdbm=n/a py_cv_module__tkinter=n/a && \
    make -j"$(nproc)" "EXTRA_CFLAGS=$PYCF" "LDFLAGS=$PYLD,--strip-all" && \
    rm python && make -j"$(nproc)" "EXTRA_CFLAGS=$PYCF" "LDFLAGS=$PYLD,--strip-all,-rpath='\$\$ORIGIN/../lib'" python && \
    make install COMPILEALL_OPTS=--invalidation-mode=checked-hash && \
    cd / && rm -rf /usr/src/python /usr/local/lib/python3.13/idlelib /usr/local/lib/python3.13/tkinter /usr/local/lib/python3.13/turtledemo /usr/local/bin/idle3* && \
    for s in pip3 pydoc3 python3 python3-config; do ln -sfT "$s" "/usr/local/bin/${s%3*}${s#*3}"; done && \
    ldconfig && /usr/local/bin/python3 -I -B -c "import ssl, sqlite3, zlib, bz2, lzma, ctypes, uuid, pyexpat, decimal, readline, curses, hashlib, sys, importlib.util as u; bad = [m for m in ('_dbm', '_gdbm', '_tkinter') if u.find_spec(m)]; assert not bad, ('built but must not be', bad); print(sys.version.replace(chr(10), ' '), '|', ssl.OPENSSL_VERSION, '| sqlite', sqlite3.sqlite_version, '| expat', pyexpat.EXPAT_VERSION)" && \
    ldd /usr/local/lib/python3.13/lib-dynload/_ssl.cpython-*.so | grep -qE 'libssl.so.3 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/_sqlite3.cpython-*.so | grep -qE 'libsqlite3.so.0 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/pyexpat.cpython-*.so | grep -qE 'libexpat.so.1 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/_ctypes.cpython-*.so | grep -qE 'libffi.so.8 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/_lzma.cpython-*.so | grep -qE 'liblzma.so.5 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/_bz2.cpython-*.so | grep -qE 'libbz2.so.1.0 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/_uuid.cpython-*.so | grep -qE 'libuuid.so.1 => /(usr/)?lib/x86_64-linux-gnu/' && ldd /usr/local/lib/python3.13/lib-dynload/zlib.cpython-*.so | grep -qE 'libz.so.1 => /(usr/)?lib/x86_64-linux-gnu/'

# Every Python stage below starts here: one interpreter for the builders and the runtime, so compiled wheels match.
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS python-base
ENV LANG=C.UTF-8
COPY --from=cpython /usr/local/ /usr/local/
# ca-certificates netbase tzdata: what the official python images add to their distro base (CA roots for pip and
# ssl, /etc/services, the zoneinfo database Django's TIME_ZONE needs); ubuntu:24.04 has none of them. Then the
# libraries the compiled interpreter loads (gen_dockerfile.PY_SRC_RUNTIME_LIBS) -- Ubuntu debs in the SBOM.
# ldconfig: libpython3.13.so is in /usr/local/lib. userdel: ubuntu:24.04 ships an `ubuntu` account holding uid/gid
# 1000; removing it lets the app account keep the uid 1000 it had on the Debian base (volume ownership unchanged).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates netbase tzdata \
      libssl3t64 zlib1g libbz2-1.0 libsqlite3-0 libffi8 liblzma5 libzstd1 libuuid1 libexpat1 libncursesw6 libtinfo6 libreadline8t64 && \
    rm -rf /var/lib/apt/lists/* && ldconfig && userdel --remove ubuntu && python3 --version

FROM python-base AS builder
ENV PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libpq-dev libffi-dev libssl-dev curl git ca-certificates unixodbc-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY --from=src /src/pyproject.toml /src/uv.lock ./
COPY constraints.txt ./constraints.txt
# pip is build-only in the venv too, so it goes once the installs are done: `python -m venv` put its own copy in
# /opt/venv, and the scan reads the urllib3, msgpack and setuptools vendored inside it (pip/_vendor/vendor.txt) as
# packages of the image. Chain 457 parked on 5 highs that were all pip 26.2.1's bundle; the venv's real urllib3 2.8.0
# and setuptools 80.10.2 were clean. Nothing runs pip at runtime.
# supervisor==4.1.0: upstream v26.9.0's own pin (pyproject.toml dependencies), which the uv export above already installs;
# until 2026-11-02 this line named no version (pip found 4.1.0 installed and kept it, as the live release's SBOM shows).
RUN python -m venv /opt/venv \
 && pip install "uv==0.11.6" \
 && uv export --frozen --no-default-groups --no-emit-project --no-hashes -o /tmp/req.txt \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/req.txt \
 && /opt/venv/bin/pip install --no-cache-dir "supervisor==4.1.0" \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade -r constraints.txt \
 && rm -rf /opt/venv/lib/python3.13/site-packages/pip /opt/venv/lib/python3.13/site-packages/pip-*.dist-info \
           /opt/venv/bin/pip /opt/venv/bin/pip3 /opt/venv/bin/pip3.13 \
 && ! /opt/venv/bin/python -c "import pip" 2>/dev/null

# the application tree's assembly (the venv, the app, the built client). Nothing of this stage's system ships: the image is
# the chiselled runtime (chiselcut below) with /usr/local, /opt/venv and /app laid in. useradd --system gives redash
# gid 999, as on every release since r1.
FROM python-base AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH \
    REDASH_VERSION_CHECK=false
RUN useradd --system --create-home --uid 1000 redash
COPY --from=builder /opt/venv /opt/venv
COPY --from=src --chown=1000:1000 /src /app
COPY --from=frontend --chown=1000:1000 /frontend/client/dist /app/client/dist
COPY supervisor-redash.conf /etc/supervisor/redash.conf
COPY entrypoint-aio.sh /usr/local/bin/entrypoint-aio.sh
RUN chmod 755 /usr/local/bin/entrypoint-aio.sh && chown -R redash:redash /app
WORKDIR /app
USER redash
EXPOSE 5000
ENTRYPOINT ["/usr/local/bin/entrypoint-aio.sh"]

FROM runtime AS export-src
USER root
RUN mkdir -p /export && \
    tar czf /export/app.tar.gz -C / app opt/venv && \
    tar czf /export/site.tar.gz -C / usr/local/lib/python3.13/site-packages && \
    echo "vendored: $(du -sh /export | cut -f1)"
# chiselled runtime (runtime_base): the files the slices need, cut from Ubuntu's own .debs by Canonical's chisel
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS chiselcut
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl file zstd && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/chisel.tgz https://github.com/canonical/chisel/releases/download/v1.5.1/chisel_v1.5.1_linux_amd64.tar.gz && \
    echo "89612f46de83e850aae11fca26a32a22cc2964891f2cc538211b906787d2b83e4496fa203a5074e06a9932f1fbe84a73  /tmp/chisel.tgz" | sha384sum -c - && tar -xzf /tmp/chisel.tgz -C /usr/local/bin chisel && \
    curl -fsSL -o /tmp/releases.tgz https://github.com/canonical/chisel-releases/archive/f2600d3aa90123db6d44bb1441a99afc8b5847d9.tar.gz && \
    echo "e5b4484bb283149ed7fc0f42ad2194fed28cae0bf1036704853d60ec31298bef  /tmp/releases.tgz" | sha256sum -c - && \
    mkdir -p /opt/chisel-releases && tar -xzf /tmp/releases.tgz -C /opt/chisel-releases --strip-components=1
COPY chisel-slice-libltdl7.yaml /tmp/rs-slices/libltdl7.yaml
RUN echo "2087e70b2ac134beb76720b25ada3f40974d39f560adce91758611e9a05086d6  /tmp/rs-slices/libltdl7.yaml" | sha256sum -c - && \
    { [ ! -e /opt/chisel-releases/slices/libltdl7.yaml ] || { echo "chisel-releases now defines libltdl7: drop it from runtime_base.slice_defs" >&2; exit 1; }; } && \
    cp /tmp/rs-slices/libltdl7.yaml /opt/chisel-releases/slices/libltdl7.yaml
COPY chisel-slice-libodbc2.yaml /tmp/rs-slices/libodbc2.yaml
RUN echo "b90645fd881f0ee47df4e266f1297bd12cf2317a71e2b5e201a5ac1a3647567a  /tmp/rs-slices/libodbc2.yaml" | sha256sum -c - && \
    { [ ! -e /opt/chisel-releases/slices/libodbc2.yaml ] || { echo "chisel-releases now defines libodbc2: drop it from runtime_base.slice_defs" >&2; exit 1; }; } && \
    cp /tmp/rs-slices/libodbc2.yaml /opt/chisel-releases/slices/libodbc2.yaml
RUN mkdir -p /rootfs /cache && XDG_CACHE_HOME=/cache chisel cut --release /opt/chisel-releases --root /rootfs base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying libssl3t64_libs zlib1g_libs libbz2-1.0_libs libsqlite3-0_libs libffi8_libs liblzma5_libs libzstd1_libs libuuid1_libs libexpat1_libs libncursesw6_libs libtinfo6_libs libreadline8t64_libs netbase_config libc-bin_locale bash_bins coreutils_id-utility libgcc-s1_libs libstdc++6_libs libodbc2_libs libpam0g_libs libaudit1_libs libcap-ng0_libs libcrypt1_libs
RUN set -eu; mkdir -p /chisel/debs /rootfs/var/lib/dpkg; : > /tmp/status; : > /chisel/packages.tsv; \
    for f in /cache/chisel/sha256/* /cache/chisel/sha512/*; do [ -f "$f" ] && file "$f" | grep -q "Debian binary package" || continue; \
      p=$(dpkg-deb -f "$f" Package); v=$(dpkg-deb -f "$f" Version); \
      cp "$f" "/chisel/debs/${p}_${v}.deb"; printf '%s\t%s\t%s\n' "$p" "$v" "$(sha256sum < "$f" | cut -c1-64)" >> /chisel/packages.tsv; done; \
    [ -s /chisel/packages.tsv ] || { echo "no .deb found in the chisel cache" >&2; exit 1; }; \
    LC_ALL=C sort -o /chisel/packages.tsv /chisel/packages.tsv; \
    cut -f1,2 /chisel/packages.tsv | while IFS="$(printf '\t')" read -r p v; do \
      dpkg-deb -f "/chisel/debs/${p}_${v}.deb" | sed '/^Package:/a Status: install ok installed' >> /tmp/status; echo >> /tmp/status; done; \
    install -m 0644 /tmp/status /rootfs/var/lib/dpkg/status; \
    mkdir -p /rootfs/var/lib/dpkg/info; [ -s /rootfs/var/lib/chisel/manifest.wall ] || \
      { echo "no chisel manifest (/var/lib/chisel/manifest.wall): the base-files_chisel slice is missing" >&2; exit 1; }; \
    zstd -dc /rootfs/var/lib/chisel/manifest.wall | grep '"kind":"path"' | \
      sed -n 's/.*"path":"\([^"]*\)".*"slices":\[\([^]]*\)\].*/\1 \2/p' | \
      while read -r path slices; do path=${path%/}; if [ -z "$path" ]; then continue; fi; \
        for s in $(echo "$slices" | tr -d '"' | tr ',' ' '); do echo "$path" >> "/rootfs/var/lib/dpkg/info/${s%%_*}.list"; done; done; \
    cut -f1 /chisel/packages.tsv | while read -r p; do l="/rootfs/var/lib/dpkg/info/$p.list"; [ -f "$l" ] || : > "$l"; \
      LC_ALL=C sort -u -o "$l" "$l"; \
      while read -r f; do if [ -f "/rootfs$f" ] && [ ! -L "/rootfs$f" ]; then (cd /rootfs && md5sum "${f#/}"); fi; done < "$l" \
        > "/rootfs/var/lib/dpkg/info/$p.md5sums"; done; \
    [ "$(ls /rootfs/var/lib/dpkg/info/*.md5sums | wc -l)" = "$(wc -l < /chisel/packages.tsv)" ] || \
      { echo "/var/lib/dpkg/info does not name every package of the cut" >&2; exit 1; }; \
    { echo "chisel v1.5.1"; echo "chisel-releases f2600d3aa90123db6d44bb1441a99afc8b5847d9"; for s in base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying libssl3t64_libs zlib1g_libs libbz2-1.0_libs libsqlite3-0_libs libffi8_libs liblzma5_libs libzstd1_libs libuuid1_libs libexpat1_libs libncursesw6_libs libtinfo6_libs libreadline8t64_libs netbase_config libc-bin_locale bash_bins coreutils_id-utility libgcc-s1_libs libstdc++6_libs libodbc2_libs libpam0g_libs libaudit1_libs libcap-ng0_libs libcrypt1_libs; do echo "$s"; done; echo "readystack-slice-def libltdl7 2087e70b2ac134beb76720b25ada3f40974d39f560adce91758611e9a05086d6"; echo "readystack-slice-def libodbc2 b90645fd881f0ee47df4e266f1297bd12cf2317a71e2b5e201a5ac1a3647567a"; } > /chisel/slices.txt; \
    tar --sort=name --numeric-owner --format=posix --pax-option=delete=atime,delete=ctime -cf /chisel/rootfs.tar -C /rootfs . && \
    echo "chiselled rootfs: $(wc -l < /chisel/packages.tsv) packages, $(du -sh /rootfs | cut -f1)"
FROM scratch AS export
COPY --from=export-src /export/ /redash-src/
COPY --from=cpython-src /vendored-python/ /redash-src/python/
COPY --from=cpython-debs /debs/ /redash-src/python/debs/
COPY --from=chiselcut /chisel /chisel
